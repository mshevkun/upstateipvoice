{
  "name": "upstate-ip-voice-website",
  "private": true,
  "scripts": {
    "minify:css": "npx clean-css-cli css/style.css -o css/style.min.css --source-map",
    "minify:js": "npx terser js/main.js -o js/main.min.js -c -m --source-map \"filename='js/main.min.js.map'\"",
    "build": "npm run minify:css && npm run minify:js",
    "build:production": "npm run build && node scripts/build-production.js",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:static": "serve .",
    "planner:build": "vite build && node scripts/publish-planner.mjs",
    "test": "node --test tests/**/*.test.js",
    "planner:eval": "node planner/eval/run.mjs",
    "planner:sync-api": "node planner/scripts/sync-api.mjs",
    "test:e2e": "npx playwright test",
    "verify:live": "node scripts/verify-live.js",
    "deploy": "node scripts/deploy.js",
    "slice:about": "node scripts/slice-about.js",
    "planner:audit": "node planner/eval/audit.mjs",
    "planner:audit:gate": "AUDIT_GATE=1 node planner/eval/audit.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "clean-css-cli": "^5.6.3",
    "serve": "^14.2.6",
    "terser": "^5.36.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
